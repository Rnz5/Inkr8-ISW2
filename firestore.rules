rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountClosed', false) != true);
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /submissions/{submissionId} {
      allow read: if signedIn() && resource.data.authorId == request.auth.uid;
      allow write: if false;
    }
    // Leaderboards and content are accessed through authenticated server handlers.
    match /{document=**} { allow read, write: if false; }
  }
}
