{
  "name": "inkr8-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/domain.test.cjs",
    "test:integration": "npm run build && node --test integration/firestore.test.cjs",
    "lint": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "npm run build && firebase deploy --only functions,firestore"
  },
  "dependencies": {
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.1.1",
    "openai": "^6.32.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^20.0.0",
    "firebase": "^11.10.0",
    "typescript": "^5.7.3"
  }
}
