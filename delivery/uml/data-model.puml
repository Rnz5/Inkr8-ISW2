@startuml
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
title Firestore rutas y referencias finales
entity "users/{uid}" as User {
 uid
 rating
 merit
 isPlaced
 currentlyInRanked
 reputation historica congelada
}
entity "submissions/{id}" as Sub {
 id
 authorId
 gamemodeName y gamemode compatible
 playmode
 status y matchStatus
 evaluation
 matchResult
 seasonRatingChange
}
entity "seasons/{YYYY-MM}" as Season {
 start y end UTC
 status
 pendingCount
 closedAt
}
entity "seasons/{id}/members/{uid}" as Member {
 userId
 rating neto
 meritEarned
 submissionCount
}
entity "seasonAssignments/{submissionId}" as Ledger {
 authorId
 seasonId
 eligible
 terminal
 confirmedAt
}
entity "themes/{themeId}" as Theme
entity "topics/{topicId}" as Topic
entity "words/{id}" as Word
Sub ..> User : authorId
Sub ..> Topic : topicId nullable
Topic ..> Theme : themeId
Ledger ..> Sub : ID de documento
Ledger ..> Season : seasonId
Season -- Member : subcoleccion real
Member ..> User : UID
note bottom of Ledger
 Referencias de aplicacion, no FK SQL.
 Colecciones historicas retiradas se preservan sin acceso nuevo.
 Solo Admin modifica temporadas y sus acuses.
end note
@enduml
